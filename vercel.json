{
  "version": 2,
  "name": "server-bench-ui",
  "outputDirectory": "server/public",
  "buildCommand": null,
  "installCommand": null,
  "framework": null,
  "routes": [
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" }
      ]
    }
  ]
}
